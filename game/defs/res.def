RES(GROUP, GRP_SC_HELLO, "SC_HELLO")
RES(SENTENCE, SEN_SC_CUREA, "SC_CUREA")
RES(SENTENCE, SEN_SC_CUREB, "SC_CUREB")
RES(SENTENCE, SEN_SC_CUREC, "SC_CUREC")
