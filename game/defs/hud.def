// The HUD's 2D sheets (include/hl64/draw2d.h sheet ids = line order of the
// HUD and FONT lines; tools/cook/bake_hlhud.py HUD_DEF follows that order,
// the sheet field of the generated HUD rectangles): HUD(IDENT, "gfx file").
// engine/render/draw2d.c loads them into the HUD region at boot. FONT
// lines are cooked WAD3 fonts with their glyph table (gfx/<name>.fnt).
// Append only.
HUD(320HUD1, "gfx/320hud1.ui8")
HUD(320HUD2, "gfx/320hud2.ui8")
HUD(CROSSHAIRS, "gfx/crosshairs.ui8")
HUD(320HUD4, "gfx/320hud4.ui8")
HUD(320_PAIN, "gfx/320_pain.ui8")
// The text font: creditsfont, the white anti-aliased font of GoldSrc's text
// messages (titles.txt; conchars is the console's outlined font).
FONT(CREDITSFONT, "gfx/creditsfont.ui8")
// The train control indicator (CHudTrain: sprites/320_train.spr, five
// frames packed by tools/cook/bake_hlhud.py, rects train_pos1..5).
HUD(320_TRAIN, "gfx/320_train.ui8")
