diff --git a/ares/n64/cartridge/testharness.cpp b/ares/n64/cartridge/testharness.cpp
index a223221..8fa2da5 100644
--- a/ares/n64/cartridge/testharness.cpp
+++ b/ares/n64/cartridge/testharness.cpp
@@ -265,3 +265,35 @@ auto Cartridge::TestHarness::hostShot(const char* tag) -> void {
   printf("[ares] screenshot %s (%ux%u bpp%u fb=0x%06x tag=%s)\n", path, width, height, bpp, base, tag);
   fflush(stdout);
 }
+
+//Pad taps: an ARES_TEST_INPUT line "<buttons-hex> <x> <y> <tap> <regex>" (tap > 0, regex
+//POSIX extended, the rest of the line) holds its buttons and stick from the first controller
+//read that sees a new tap number until a complete ISViewer log line matches the regex; from
+//then on that tap injects nothing until the file names another number. The press ends in the
+//emulated frame the cart answers it, so it is one press however fast ares runs against the
+//script that writes the file (no menu auto-repeat). Returns whether the tap is held.
+auto Cartridge::TestHarness::tapHolds(u32 tap, const char* until) -> bool {
+  if(tap != tapId) {
+    if(tapCompiled) regfree(&tapRe);
+    tapId = tap;
+    tapCompiled = regcomp(&tapRe, until, REG_EXTENDED | REG_NOSUB) == 0;
+    tapHeld = tapCompiled;
+    printf("TESTHARNESS tap %u%s\n", tap, tapCompiled ? "" : ": bad regex");
+    fflush(stdout);
+  }
+  return tapHeld;
+}
+
+auto Cartridge::TestHarness::logChar(char c) -> void {
+  if(c != '\n') {
+    if(c != '\r' && logLen < sizeof(logLine) - 1) logLine[logLen++] = c;
+    return;
+  }
+  logLine[logLen] = 0;
+  logLen = 0;
+  if(tapHeld && regexec(&tapRe, logLine, 0, nullptr, 0) == 0) {
+    tapHeld = false;
+    printf("TESTHARNESS tap %u released\n", tapId);
+    fflush(stdout);
+  }
+}
