FlashRAM saves for the test harness (hl64 M6, SaveGame): on ares-testharness.patch.

 - testharness.cpp: with ARES_TEST_HARNESS set the cart's FlashRAM (the ROM header's save
   type flashram) starts erased, or from the raw 128 KB image ARES_FLASH_IN names, never
   from a <rom>.flash a run left beside the ROM; the guest's exit through the harness
   device writes the chip image to ARES_FLASH_OUT (it ends in _Exit, which skips ares' own
   Cartridge::save / emulator save: those only run at unload and every 30 s).
   Both files hold the chip's bytes in order (as hl64-host's image and the chip itself):
   ares keeps the array as host-order 32-bit words, so they are copied byte by byte
   through Memory::Writable, not as the raw array.
 (The sector erase clearing one page instead of the 16 KB sector, fixed here for the
 earlier ares base, is right in this one.)

diff --git a/ares/n64/cartridge/testharness.cpp b/ares/n64/cartridge/testharness.cpp
index 212cdb8..8e497fa 100644
--- a/ares/n64/cartridge/testharness.cpp
+++ b/ares/n64/cartridge/testharness.cpp
@@ -25,6 +25,13 @@
 // shows a picture and then every <ms> of wall time (checked once per frame),
 // at most ARES_HOST_SHOT_MAX (default 240); each dump logs one
 // "[ares] screenshot <path> (...)" line.
+//
+// FlashRAM saves (ROM header save type flashram): the run starts from an erased chip, or
+// from the 128 KB raw image ARES_FLASH_IN names, never from a <rom>.flash a run left beside
+// the ROM; ARES_FLASH_OUT=<file> gets the chip's image when the guest exits through this
+// device (the exit does not run the emulator's own save, which only autosaves every 30 s
+// and at unload). Both files hold the chip's bytes in order (the array keeps host-order
+// words: byte accesses through Memory::Writable).
 
 auto Cartridge::TestHarness::load() -> void {
   active = getenv("ARES_TEST_HARNESS") != nullptr;
@@ -59,6 +66,25 @@ auto Cartridge::TestHarness::load() -> void {
     if(!maxPeriodic) maxPeriodic = 240;
   }
   fflush(stdout);
+
+  if(active && cartridge.flash.size) {
+    Memory::Writable& chip = cartridge.flash;
+    chip.fill(~0u);
+    if(auto path = getenv("ARES_FLASH_IN")) {
+      u32 size = chip.size;
+      std::vector<u8> image(size);
+      FILE* fp = fopen(path, "rb");
+      if(!fp || fread(image.data(), 1, size, fp) != size || fgetc(fp) != EOF) {
+        printf("TESTHARNESS flash in: %s is not a readable %u-byte image\n", path, size);
+        fflush(stdout);
+        ::_Exit(2);
+      }
+      fclose(fp);
+      for(u32 address : range(size)) chip.write<Byte>(address, image[address]);
+      printf("TESTHARNESS flash in %s (%u bytes)\n", path, size);
+      fflush(stdout);
+    }
+  }
 }
 
 auto Cartridge::TestHarness::piAddress(u32 address, PIDeviceTiming) -> bool {
@@ -141,6 +167,24 @@ auto Cartridge::TestHarness::exitEmulator() -> void {
   if(arg1 || arg2) printf("TESTHARNESS exit %u (arg1=0x%08x arg2=0x%08x)\n", arg0, arg1, arg2);
   else printf("TESTHARNESS exit %u\n", arg0);
   fflush(stdout);
+
+  if(auto path = getenv("ARES_FLASH_OUT")) {
+    if(cartridge.flash.size) {
+      Memory::Writable& chip = cartridge.flash;
+      std::vector<u8> image(chip.size);
+      for(u32 address : range(chip.size)) image[address] = chip.read<Byte>(address);
+      FILE* fp = fopen(path, "wb");
+      if(fp && fwrite(image.data(), 1, image.size(), fp) == image.size() && !fclose(fp)) {
+        printf("TESTHARNESS flash out %s (%u bytes)\n", path, (u32)chip.size);
+      } else {
+        printf("TESTHARNESS flash out: cannot write %s\n", path);
+      }
+    } else {
+      printf("TESTHARNESS flash out: the ROM has no FlashRAM (N64_ROM_SAVETYPE=flashram)\n");
+    }
+    fflush(stdout);
+  }
+
   ::_Exit((int)arg0);
 }
 
