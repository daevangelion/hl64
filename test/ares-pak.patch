+// Controller Pak (controller 1; ares gives one to every ROM whose homebrew header names no
+// controllers): a run's Pak starts formatted, or from the raw image ARES_PAK_IN names
+// (Gamepad::connect); ARES_PAK_OUT=<file> gets the Pak's image when the guest exits here.
+//
 // Register map (32-bit CPU accesses):
 //   +0x00  CMD   (w): 1 = screenshot, 2 = exit
 //   +0x04  ARG0  (w): screenshot: RDRAM byte address of framebuffer
@@ -171,6 +175,24 @@
     fflush(stdout);
