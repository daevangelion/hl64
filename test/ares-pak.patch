Controller Pak saves for the test harness (hl64 M6, SaveGame): on ares-testharness.patch
and ares-flash.patch.

 - mia/medium/nintendo-64.cpp: our ROM's advanced homebrew header names no controllers
   (N64_ROM_CONTROLLER1 unset); ares now gives such ROMs a Rumble Pak on controller 1.
   With ARES_TEST_HARNESS set they get ares' earlier default: controller 1 with a
   Controller Pak, controller 2 with a Rumble Pak.
 - gamepad.cpp: with ARES_TEST_HARNESS set a Controller Pak starts formatted (ares' own
   format, one bank), never from a <rom>.pak a run left beside the ROM; controller 1's is
   loaded from the raw image ARES_PAK_IN names (exactly the Pak's size, 32 KB; else exit
   2).
 - testharness.cpp: the guest's exit through the harness device writes controller 1's Pak
   to ARES_PAK_OUT (the exit ends in _Exit, which skips ares' own save of save.pak).

diff --git a/ares/n64/cartridge/testharness.cpp b/ares/n64/cartridge/testharness.cpp
index 8e497fa..a223221 100644
--- a/ares/n64/cartridge/testharness.cpp
+++ b/ares/n64/cartridge/testharness.cpp
@@ -32,6 +32,10 @@
 // device (the exit does not run the emulator's own save, which only autosaves every 30 s
 // and at unload). Both files hold the chip's bytes in order (the array keeps host-order
 // words: byte accesses through Memory::Writable).
+//
+// Controller Pak (controller 1; ares gives one to every ROM whose homebrew header names no
+// controllers): a run's Pak starts formatted, or from the raw image ARES_PAK_IN names
+// (Gamepad::connect); ARES_PAK_OUT=<file> gets the Pak's image when the guest exits here.
 
 auto Cartridge::TestHarness::load() -> void {
   active = getenv("ARES_TEST_HARNESS") != nullptr;
@@ -185,6 +189,24 @@ auto Cartridge::TestHarness::exitEmulator() -> void {
     fflush(stdout);
   }
 
+  if(auto path = getenv("ARES_PAK_OUT")) {
+    auto gamepad = dynamic_cast<Gamepad*>(controllerPort1.device.get());
+    if(gamepad && gamepad->slot && gamepad->slot->name() == "Controller Pak") {
+      //the Pak's bytes in order (its ram keeps host-order words: byte accesses)
+      std::vector<u8> image(gamepad->ram.size);
+      for(u32 address : range(gamepad->ram.size)) image[address] = gamepad->ram.read<Byte>(address);
+      FILE* fp = fopen(path, "wb");
+      if(fp && fwrite(image.data(), 1, image.size(), fp) == image.size() && !fclose(fp)) {
+        printf("TESTHARNESS pak out %s (%u bytes)\n", path, (u32)gamepad->ram.size);
+      } else {
+        printf("TESTHARNESS pak out: cannot write %s\n", path);
+      }
+    } else {
+      printf("TESTHARNESS pak out: no Controller Pak in controller 1\n");
+    }
+    fflush(stdout);
+  }
+
   ::_Exit((int)arg0);
 }
 
diff --git a/ares/n64/controller/gamepad/gamepad.cpp b/ares/n64/controller/gamepad/gamepad.cpp
index c25e9c7..de93e4e 100644
--- a/ares/n64/controller/gamepad/gamepad.cpp
+++ b/ares/n64/controller/gamepad/gamepad.cpp
@@ -113,6 +113,33 @@ auto Gamepad::connect() -> void {
         ram.save(pak->write("save.pak"));
       }
     }
+
+    //test harness (ARES_TEST_HARNESS): a run's Controller Paks start formatted, never from a
+    //save.pak a previous run left; controller 1's from the raw image ARES_PAK_IN names when
+    //set (ARES_PAK_OUT gets it at the guest's exit: Cartridge::TestHarness::exitEmulator).
+    //The image is the Pak's bytes in order (ram keeps host-order words: byte accesses)
+    if(getenv("ARES_TEST_HARNESS")) {
+      system.controllerPakBankCount = system.configuredControllerPakBankCount;
+      ram.allocate(system.controllerPakBankCount * 32_KiB);
+      formatControllerPak();
+      if(controllerPort1.device.get() == this) {
+        if(auto path = getenv("ARES_PAK_IN")) {
+          std::vector<u8> image(ram.size);
+          FILE* fp = fopen(path, "rb");
+          if(!fp || fread(image.data(), 1, ram.size, fp) != ram.size || fgetc(fp) != EOF) {
+            printf("TESTHARNESS pak in: %s is not a readable %u-byte image\n", path, (u32)ram.size);
+            fflush(stdout);
+            ::_Exit(2);
+          }
+          fclose(fp);
+          for(u32 address : range(ram.size)) ram.write<Byte>(address, image[address]);
+          printf("TESTHARNESS pak in %s (%u bytes)\n", path, (u32)ram.size);
+        } else {
+          printf("TESTHARNESS pak: controller 1 has a formatted Controller Pak\n");
+        }
+        fflush(stdout);
+      }
+    }
   }
   if(slot->name() == "Rumble Pak") {
     motor = node->append<Node::Input::Rumble>("Rumble");
diff --git a/mia/medium/nintendo-64.cpp b/mia/medium/nintendo-64.cpp
--- a/mia/medium/nintendo-64.cpp
+++ b/mia/medium/nintendo-64.cpp
@@ -834,6 +834,13 @@
       // No controllers configured. By default, just enable Rumble Pak as that
       // doesn't hurt in any way, nor create save files.
       rpaks[0] = true;
+      // test harness (ARES_TEST_HARNESS): ares' earlier default, a Controller Pak on
+      // controller 1 and a Rumble Pak on controller 2 (ares-pak.patch's Pak in / out)
+      if(getenv("ARES_TEST_HARNESS")) {
+        rpaks[0] = false;
+        cpaks[0] = true;
+        rpaks[1] = true;
+      }
     }
   }
 
