+  if(auto path = getenv("ARES_PAK_OUT")) {
+    auto gamepad = dynamic_cast<Gamepad*>(controllerPort1.device.get());
+    if(gamepad && gamepad->slot && gamepad->slot->name() == "Controller Pak") {
+      //the Pak's bytes in order (its ram keeps host-order words: byte accesses)
