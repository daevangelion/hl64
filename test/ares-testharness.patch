diff --git a/ares/n64/cartridge/testharness.cpp b/ares/n64/cartridge/testharness.cpp
new file mode 100644
index 0000000..d9c6d3b
--- /dev/null
+++ b/ares/n64/cartridge/testharness.cpp
@@ -0,0 +1,86 @@
+// Test harness peripheral for automated ROM testing (quakegeneric N64 port).
+//
+// A fake PI-bus device at 0x13fe0000-0x13fe0fff, modeled on ISViewer's
+// integration. Guest ROMs drive the emulator: capture a screenshot of any
+// RDRAM framebuffer, or exit the emulator with a status code, so CI scripts
+// can run a ROM to completion and collect artifacts without GUI automation.
+// On real hardware the address range is open bus and the writes are inert.
+//
+// Enabled only when the ARES_TEST_HARNESS environment variable is set.
+//
+// Register map (32-bit CPU accesses):
+//   +0x00  CMD   (w): 1 = screenshot, 2 = exit
+//   +0x04  ARG0  (w): screenshot: RDRAM byte address of framebuffer
+//                     exit: process exit code
+//   +0x08  ARG1  (w): screenshot: (width << 16) | height
+//   +0x0c  ARG2  (w): screenshot: bytes per pixel (2 = RGBA5551, 4 = RGBA8888)
+//   +0x10  MAGIC (r): 0x54455354 "TEST" — presence probe for the guest
+
+auto Cartridge::TestHarness::load() -> void {
+  active = getenv("ARES_TEST_HARNESS") != nullptr;
+  shots = 0;
+  if(active) {
+    printf("TESTHARNESS enabled at 0x13fe0000\n");
+    fflush(stdout);
+  }
+}
+
+auto Cartridge::TestHarness::readWord(u32 address) -> u32 {
+  address &= 0xfff;
+  if(address == 0x10) return 0x54455354;  //"TEST"
+  return 0;
+}
+
+auto Cartridge::TestHarness::writeWord(u32 address, u32 data) -> void {
+  address &= 0xfff;
+  switch(address) {
+  case 0x04: arg0 = data; return;
+  case 0x08: arg1 = data; return;
+  case 0x0c: arg2 = data; return;
+  case 0x00:
+    if(data == 1) return screenshot();
+    if(data == 2) return exitEmulator();
+    return;
+  default: return;
+  }
+}
+
+auto Cartridge::TestHarness::screenshot() -> void {
+  u32 base   = arg0 & 0x007f'ffff;
+  u32 width  = arg1 >> 16;
+  u32 height = arg1 & 0xffff;
+  u32 bpp    = arg2;
+
+  if(!width || !height || width > 1024 || height > 1024) return;
+  if(bpp != 2 && bpp != 4) return;
+
+  char name[64];
+  snprintf(name, sizeof(name), "ares-test-%04u.ppm", shots++);
+  FILE* fp = fopen(name, "wb");
+  if(!fp) return;
+
+  fprintf(fp, "P6\n%u %u\n255\n", width, height);
+  for(u32 pixel : range(width * height)) {
+    u8 r, g, b;
+    if(bpp == 2) {
+      u16 px = rdram.ram.read<Half>(base + pixel * 2, "TestHarness");
+      r = px >> 11 & 31; g = px >> 6 & 31; b = px >> 1 & 31;
+      r = r << 3 | r >> 2; g = g << 3 | g >> 2; b = b << 3 | b >> 2;
+    } else {
+      u32 px = rdram.ram.read<Word>(base + pixel * 4, "TestHarness");
+      r = px >> 24; g = px >> 16; b = px >> 8;
+    }
+    fputc(r, fp); fputc(g, fp); fputc(b, fp);
+  }
+  fclose(fp);
+
+  printf("TESTHARNESS screenshot %s (%ux%u bpp%u from 0x%06x)\n",
+    name, width, height, bpp, base);
+  fflush(stdout);
+}
+
+auto Cartridge::TestHarness::exitEmulator() -> void {
+  printf("TESTHARNESS exit %u\n", arg0);
+  fflush(stdout);
+  ::_Exit((int)arg0);
+}
diff --git a/ares/n64/controller/gamepad/gamepad.cpp b/ares/n64/controller/gamepad/gamepad.cpp
index 2da6bde..eb83df8 100644
--- a/ares/n64/controller/gamepad/gamepad.cpp
+++ b/ares/n64/controller/gamepad/gamepad.cpp
@@ -432,6 +432,33 @@ auto Gamepad::read() -> n32 {
     data.bit(28) = 0;  //Start
   }
 
+  //test harness: merge injected state from the file named by ARES_TEST_INPUT.
+  //file holds one line: "<buttons-hex> <stick_x> <stick_y>", where buttons use
+  //this word's bit layout (bit31=A, 30=B, 29=Z, 28=Start, 27-24=dU/dD/dL/dR,
+  //21=L, 20=R, 19-16=cU/cD/cL/cR) and the stick is in raw -85..85 units.
+  static const char* injectPath = getenv("ARES_TEST_INPUT");
+  if(injectPath) {
+    if(FILE* fp = fopen(injectPath, "r")) {
+      unsigned buttons = 0; int sx = 0, sy = 0;
+      if(fscanf(fp, "%x %d %d", &buttons, &sx, &sy) >= 1) {
+        if(buttons || sx || sy) {
+          static u32 lastLogged = ~0u;
+          if(buttons != lastLogged) {
+            printf("TESTHARNESS inject buttons=%08x stick=%d,%d\n", buttons, sx, sy);
+            fflush(stdout);
+            lastLogged = buttons;
+          }
+        }
+        data = data | buttons;
+        if(sx || sy) {
+          data.byte(0) = s8(sy);
+          data.byte(1) = s8(sx);
+        }
+      }
+      fclose(fp);
+    }
+  }
+
   return data;
 }
 
diff --git a/ares/n64/pi/bus.hpp b/ares/n64/pi/bus.hpp
index 5ff3b72..fc1ff2c 100644
--- a/ares/n64/pi/bus.hpp
+++ b/ares/n64/pi/bus.hpp
@@ -48,6 +48,10 @@ inline auto PI::busRead(u32 address) -> u32 {
   if(cartridge.isviewer.enabled() && address >= 0x13ff'0000 && address <= 0x13ff'ffff) {
     return cartridge.isviewer.read<Size>(address);
   }
+  if(cartridge.testharness.enabled() && address >= 0x13fe'0000 && address <= 0x13fe'0fff) {
+    if constexpr(Size == Word) return cartridge.testharness.readWord(address);
+    return unmapped;
+  }
   if(address <= 0x1000'0000 + cartridge.rom.size - 1) {
     return cartridge.rom.read<Size>(address);
   }
@@ -104,6 +108,13 @@ inline auto PI::busWrite(u32 address, u32 data) -> void {
       debug(unhandled, "[PI::busWrite] attempt to write to ISViewer: ROM is too big so ISViewer is disabled");
     }
   }
+  if(cartridge.testharness.enabled() && address >= 0x13fe'0000 && address <= 0x13fe'0fff) {
+    if constexpr(Size == Word) {
+      writeForceFinish();  //test channel, be gentle
+      cartridge.testharness.writeWord(address, data);
+    }
+    return;
+  }
   if(address <= 0x1000'0000 + cartridge.rom.size - 1) {
     return cartridge.rom.write<Size>(address, data);
   }
