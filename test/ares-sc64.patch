     case Queue::DD_BM_Request:  return dd.bmRequest();
     case Queue::DD_Motor_Mode:  return dd.motorChange();
     case Queue::GDB_Poll:      return cpu.gdbPoll();
+    case Queue::SC64_Command:  return sc64.complete();
     }
   });
 
