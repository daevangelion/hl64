 }
 
+//SD_READ / SD_WRITE: done at once, or busy sectors * ARES_SC64_SECTOR_US of emulated time
+//(1 s = 187.5M queue clocks) before complete() clears CMD_BUSY and raises CMD_IRQ_PENDING
+auto SC64::completeAfter(u32 sectors) -> void {
+  if(!sectorBusyUs) return complete();
+  u64 clocks = u64(sectors) * sectorBusyUs * 375 / 2;
+  cpu.queueInsert(Queue::SC64_Command, (u32)min<u64>(clocks, 0xffff'ffffull));
+}
